# -----------------------------------------------------------------------------
# Phan Tộc — Gia Phả Họ Phan
# Mẫu biến môi trường (Environment variables)
# -----------------------------------------------------------------------------
# Hướng dẫn:
#   1. Sao chép file này thành ".env.local"
#   2. Điền các giá trị thực tế tương ứng với dự án Supabase của bạn

# Tên ứng dụng hiển thị
SITE_NAME="Phan Tộc"

# Phụ đề
SITE_SUBTITLE="Gia Phả Họ Phan"

# Supabase — lấy từ Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY="your-anon-or-public-key"

# (Tuỳ chọn) Trang demo công khai
DEMO_DOMAIN=""
